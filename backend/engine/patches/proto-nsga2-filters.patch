 """Tests for the generic genetic algorithm optimizer."""
 
+import copy
 from contextlib import nullcontext
 
 import pytest
@@ -25,6 +26,115 @@ from proto_language.optimizer.genetic_algorithm_optimizer import (
 )
 
 
+def _filtered_nsga2(seeds, rejected):
+    """Build a CPU-only native program with strict filter-before-score checks."""
+    segment = Segment(sequence=seeds[0], sequence_type="dna", label="candidate")
+    segment.result_sequences = [Sequence(sequence=s, sequence_type="dna") for s in seeds]
+    scored = []
+
+    def admissible(rows, config):
+        return [ConstraintOutput(score=float(seq.sequence in rejected)) for (seq,) in rows]
+
+    def loss(rows, config):
+        values = []
+        for (seq,) in rows:
+            assert seq.sequence not in rejected
+            scored.append(seq.sequence)
+            values.append(ConstraintOutput(score=0.8))
+        return values
+
+    optimizer = GeneticAlgorithmOptimizer(
+        constructs=[Construct([segment])],
+        generators=[],
+        constraints=[
+            Constraint(inputs=[segment], function=admissible, threshold=0, label="admissible"),
+            Constraint(inputs=[segment], function=loss, label="loss"),
+        ],
+        config=GeneticAlgorithmOptimizerConfig(
+            num_generations=2,
+            population_size=len(seeds),
+            num_results=len(seeds),
+            offspring_per_generation=1,
+            crossover_rate=0,
+            survivor_selection="nsga2",
+            track_proposals=True,
+        ),
+    )
+    return segment, optimizer, scored
+
+
+def test_nsga2_filters_skip_objectives_and_preserve_rejection_outcomes() -> None:
+    segment, optimizer, scored = _filtered_nsga2(["TTTT", "AAAA", "CCCC", "GGGG"], {"TTTT", "CCCC", "GGGG"})
+    Program([optimizer], num_results=4, seed=7, compute=nullcontext()).run()
+    assert scored and set(scored) == {"AAAA"}
+    assert segment.result_sequences
+    assert all(seq.sequence == "AAAA" for seq in segment.result_sequences)
+    assert "admissible" in optimizer._population_outcomes
+    assert all(
+        vector == []
+        for vector, outcome in zip(optimizer._population_objectives, optimizer._population_outcomes, strict=True)
+        if outcome != "accepted"
+    )
+    assert len(segment.result_sequences) < 4
+    assert len(optimizer.energy_scores) == len(segment.result_sequences)
+    assert len(optimizer.history) == 3
+
+
+def test_nsga2_rejected_child_cannot_reuse_parent_scores(monkeypatch) -> None:
+    segment, optimizer, scored = _filtered_nsga2(["AAAA", "AAAA"], {"TTTT"})
+
+    def rejected_offspring(parents, energies, generation):
+        child = copy.deepcopy(parents[0][0])
+        assert "loss" in child._constraints_metadata
+        child.sequence = "TTTT"
+        return [[child]]
+
+    monkeypatch.setattr(optimizer, "_make_offspring", rejected_offspring)
+    Program([optimizer], num_results=2, seed=7, compute=nullcontext()).run()
+    assert set(scored) == {"AAAA"}
+    assert [seq.sequence for seq in segment.result_sequences] == ["AAAA", "AAAA"]
+    assert optimizer._population_outcomes == ["accepted", "accepted"]
+
+
+def test_nsga2_all_rejected_returns_no_accepted_results() -> None:
+    segment, optimizer, scored = _filtered_nsga2(["TTTT", "CCCC"], {"TTTT", "CCCC"})
+    Program([optimizer], num_results=2, seed=7, compute=nullcontext()).run()
+    assert not scored
+    assert segment.result_sequences == []
+    assert optimizer.energy_scores == []
+    assert optimizer._population_outcomes == ["admissible", "admissible"]
+
+
+def test_nsga2_can_recover_from_an_all_rejected_population(monkeypatch) -> None:
+    segment, optimizer, _scored = _filtered_nsga2(["TTTT", "CCCC"], {"TTTT", "CCCC"})
+    monkeypatch.setattr(optimizer, "_make_offspring", lambda *_: [[Sequence(sequence="AAAA", sequence_type="dna")]])
+    Program([optimizer], num_results=2, seed=7, compute=nullcontext()).run()
+    assert [seq.sequence for seq in segment.result_sequences] == ["AAAA", "AAAA"]
+
+
+def test_nsga2_filter_eligibility_does_not_depend_on_scalar_penalty(monkeypatch) -> None:
+    segment, optimizer, _scored = _filtered_nsga2(["AAAA", "TTTT"], {"TTTT"})
+    score = optimizer.score_energy
+    monkeypatch.setattr(optimizer, "score_energy", lambda: score(filter_penalty=-100.0))
+    Program([optimizer], num_results=2, seed=7, compute=nullcontext()).run()
+    assert all(seq.sequence == "AAAA" for seq in segment.result_sequences)
+
+
+def test_nsga2_still_rejects_missing_objectives_on_eligible_candidates() -> None:
+    segment, optimizer, _scored = _filtered_nsga2(["AAAA", "CCCC"], set())
+    with pytest.raises(ValueError, match="missing metadata"):
+        optimizer._extract_objective_vectors([[segment.original_sequence]], ["accepted"])
+
+
+def test_nsga2_crowding_ignores_rejected_first_vector() -> None:
+    objectives = [[], [0.1, 0.8], [0.8, 0.1], [0.5, 0.5], []]
+    assert _non_dominated_sort(objectives) == [[1, 2, 3], [0, 4]]
+    distances = _crowding_distance(objectives, [1, 2, 3])
+    assert distances[3] == pytest.approx(2.0)
+    assert _crowding_distance(objectives, [0, 4]) == {0: 0.0, 4: 0.0}
+    assert set(_nsga2_select_survivors(objectives, 2)) == {1, 2}
+
