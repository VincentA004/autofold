+"""Scoped public Generator.sample lifecycle observation.
+
+Sampling observations encompass the full native orchestration, including tied
+segment mirroring and stale metadata cleanup. They never replace generator or
+optimizer methods. Contexts do not implicitly propagate to threads/processes.
+
+Examples:
+    >>> observer = SamplingObserver()
+    >>> with sampling_observation_scope(observer):
+    ...     pass
+"""
+
+from __future__ import annotations
+
+import uuid
+from collections.abc import Iterator
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from typing import Any
+from threading import RLock
+
+from proto_tools.utils.execution_observer import ExecutionCancelled, ExecutionControl
+
+
+SCOPED_SAMPLING_API_VERSION = 1
+
+
+@dataclass(frozen=True)
+class SamplingObservation:
+    """The exact generator and identity of one public sample invocation.
+
+    Examples:
+        >>> event = SamplingObservation("sample", object(), None)
+        >>> event.sample_id
+        'sample'
+    """
+
+    sample_id: str
+    generator: Any
+    parent_sample_id: str | None
+
+
+class SamplingObserver:
+    """Subclass to admit samples and capture their complete native outcome.
+
+    A before callback may reject before sampling. Only admitted calls receive
+    one completed/failed callback. Cancellation derives from BaseException and
+    therefore propagates across ordinary per-lane failure handling.
+
+    Examples:
+        >>> observer = SamplingObserver()
+        >>> with sampling_observation_scope(observer):
+        ...     pass
+    """
+
+    def before_sample(self, event: SamplingObservation) -> object:
+        """Admit a sample and return its opaque correlation token."""
+        return None
+
+    def sample_completed(self, event: SamplingObservation, token: object) -> None:
+        """Observe proposals after mirroring and metadata cleanup."""
+
+    def sample_failed(self, event: SamplingObservation, token: object, error: BaseException) -> None:
+        """Observe an escaping sampling failure or cancellation."""
+
+
+@dataclass
+class _SamplingScope:
+    observer: SamplingObserver
+    control: ExecutionControl | None
+    active: bool = True
+
+
+_scope: ContextVar[_SamplingScope | None] = ContextVar("proto_sampling_observer", default=None)
+_scope_lock = RLock()
+_managed_scope: _SamplingScope | None = None
+_sample: ContextVar[SamplingObservation | None] = ContextVar("proto_observed_sample", default=None)
+
+
+@contextmanager
+def sampling_observation_scope(observer: SamplingObserver, control: ExecutionControl | None = None,
+                               *, require_scoped_calls: bool = False) -> Iterator[None]:
+    """Install one observer; optionally reject escaped hosted-process sampling.
+
+    Copy the context explicitly for native concurrent work. Copies share the
+    observer/control and expire on scope exit. Unobserved use is unchanged.
+    """
+    global _managed_scope
+    with _scope_lock:
+        if _scope.get() is not None or _managed_scope is not None:
+            raise RuntimeError("A sampling observer is already installed in this context or managed process")
+        if control is not None:
+            control.check()
+        state = _SamplingScope(observer, control)
+        if require_scoped_calls:
+            _managed_scope = state
+        handle = _scope.set(state)
+    try:
+        yield
+    finally:
+        with _scope_lock:
+            state.active = False
+            _scope.reset(handle)
+            if _managed_scope is state:
+                _managed_scope = None
+
+
+@contextmanager
+def observe_sample(generator: Any) -> Iterator[None]:
+    """Observe the public sample body without modifying its scientific behavior."""
+    with _scope_lock:
+        scope = _scope.get()
+        if _managed_scope is not None and scope is not _managed_scope:
+            raise ExecutionCancelled("Sampling escaped the managed observation scope")
+        if scope is not None and not scope.active:
+            raise ExecutionCancelled("Sampling observation scope has expired")
+    if scope is None:
+        yield
+        return
+    observer, control = scope.observer, scope.control
+    if control is not None:
+        control.check()
+    parent = _sample.get()
+    event = SamplingObservation(uuid.uuid4().hex, generator, parent.sample_id if parent else None)
+    token = observer.before_sample(event)
+    handle = _sample.set(event)
+    try:
+        if control is not None:
+            control.check()
+        yield
+    except BaseException as error:
+        observer.sample_failed(event, token, error)
+        raise
+    else:
+        observer.sample_completed(event, token)
+    finally:
+        _sample.reset(handle)
