+"""Serial composition of independent native Program lanes.
+
+A PortfolioProgram preserves each lane's native optimizer behavior and seed.
+Unlike sequential Program stages, lanes must not share constructs, segments or
+generators. Candidate selection and resource policy belong to the caller.
+
+Examples:
+    >>> # portfolio = PortfolioProgram([first_program, second_program])
+    >>> # portfolio.run()  # run independent programs serially
+"""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from dataclasses import dataclass
+from typing import Any
+
+from proto_language.core.program import Program
+
+
+@dataclass(frozen=True)
+class PortfolioLane:
+    """A named independent Program lane.
+
+    Examples:
+        >>> # lane = PortfolioLane(program, name="broad-search")
+    """
+
+    program: Program
+    name: str | None = None
+
+
+class PortfolioProgram:
+    """Execute independent programs serially and retain per-lane failure evidence.
+
+    At least one lane must succeed. BaseException, including cooperative
+    cancellation, always propagates immediately. Optimizer settings are unchanged.
+
+    Examples:
+        >>> # portfolio = PortfolioProgram([first_program, second_program])
+        >>> # portfolio.constructs  # all independent constructs
+    """
+
+    def __init__(self, lanes: Iterable[Program | PortfolioLane]) -> None:
+        self.lanes = [lane if isinstance(lane, PortfolioLane) else PortfolioLane(lane) for lane in lanes]
+        if not self.lanes:
+            raise ValueError("A portfolio requires at least one native Program lane")
+        self.programs = [lane.program for lane in self.lanes]
+        self.lane_failures: list[dict[str, Any]] = []
+        owners: dict[int, int] = {}
+        for index, program in enumerate(self.programs):
+            if not isinstance(program, Program):
+                raise TypeError("Every portfolio lane must be a native Program")
+            objects = [*program.constructs, *(segment for construct in program.constructs for segment in construct.segments),
+                       *(generator for optimizer in program.optimizers for generator in optimizer.generators)]
+            for item in objects:
+                owner = owners.get(id(item))
+                if owner is not None and owner != index:
+                    raise ValueError(f"Portfolio lanes {owner} and {index} share scientific state")
+                owners[id(item)] = index
+
+    @property
+    def optimizers(self) -> list[Any]:
+        """All native optimizers, in lane and stage order."""
+        return [optimizer for program in self.programs for optimizer in program.optimizers]
+
+    @property
+    def constructs(self) -> list[Any]:
+        """All independent native constructs, in lane order."""
+        return [construct for program in self.programs for construct in program.constructs]
+
+    def run(self) -> None:
+        """Run lanes serially; retain ordinary failures and require one success."""
+        self.lane_failures = []
+        completed = 0
+        for index, lane in enumerate(self.lanes):
+            try:
+                lane.program.run()
+                completed += 1
+            except Exception as error:
+                self.lane_failures.append({"lane": index, "name": lane.name,
+                                           "errorType": type(error).__name__, "message": str(error)})
+        if completed == 0:
+            summary = "; ".join(f"lane {item['lane']}: {item['errorType']}: {item['message']}" for item in self.lane_failures)
+            raise RuntimeError("Every portfolio lane failed: " + summary)
