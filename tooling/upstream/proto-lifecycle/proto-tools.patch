diff --git a/proto_tools/utils/execution_observer.py b/proto_tools/utils/execution_observer.py
new file mode 100644
index 0000000..45b78c9
--- /dev/null
+++ b/proto_tools/utils/execution_observer.py
@@ -0,0 +1,203 @@
+"""Scoped registered-request observation and cooperative cancellation.
+
+Observe a complete public registry call without replacing its dispatch backend,
+preprocessing, cache, retry or output processing. Origins describe registry cache
+branches, never physical inference counts. Contexts are local to the calling
+Python context; callers must propagate them explicitly to another thread/process.
+Cancellation cannot preempt an already-running blocking native operation.
+
+Examples:
+    >>> control = ExecutionControl()
+    >>> control.cancel()
+    >>> control.cancelled
+    True
+"""
+
+from __future__ import annotations
+
+import math
+import time
+import uuid
+from collections.abc import Iterator
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from threading import Event, RLock
+from typing import Any, Literal
+
+SCOPED_REQUEST_API_VERSION = 1
+
+CacheOrigin = Literal["unobserved", "cache_hit", "cache_partial", "cache_miss", "cache_disabled", "external_dispatch_backend"]
+
+
+class ExecutionCancelled(BaseException):
+    """Cooperative execution cancellation; never converted to a tool error/retry.
+
+    Examples:
+        >>> isinstance(ExecutionCancelled("cancelled"), Exception)
+        False
+    """
+
+
+class ExecutionControl:
+    """An explicit cancellation token and optional monotonic deadline.
+
+    Examples:
+        >>> control = ExecutionControl(deadline=time.monotonic() + 60)
+        >>> control.check()
+    """
+
+    def __init__(self, deadline: float | None = None) -> None:
+        if deadline is not None and (isinstance(deadline, bool) or not math.isfinite(deadline)):
+            raise ValueError("Execution deadline must be a finite monotonic timestamp")
+        self.deadline = deadline
+        self._cancelled = Event()
+
+    @property
+    def cancelled(self) -> bool:
+        """Whether cancellation was requested."""
+        return self._cancelled.is_set()
+
+    def cancel(self) -> None:
+        """Request cancellation at the next cooperative boundary."""
+        self._cancelled.set()
+
+    def check(self) -> None:
+        """Raise when cancelled or the monotonic deadline has expired."""
+        if self.cancelled or (self.deadline is not None and time.monotonic() >= self.deadline):
+            raise ExecutionCancelled("Execution cancelled or its monotonic deadline expired")
+
+
+@dataclass
+class RequestObservation:
+    """One registered API request; inputs/config are the normalized caller values.
+
+    Observers must not mutate inputs, config or the returned output. The opaque
+    token returned by before_request correlates completion without frame lookup.
+
+    Examples:
+        >>> event = RequestObservation("id", "example", None, None, None)
+        >>> event.cache_origin
+        'unobserved'
+    """
+
+    request_id: str
+    key: str
+    inputs: Any
+    config: Any
+    parent_request_id: str | None
+    cache_origin: CacheOrigin = "unobserved"
+    result: Any = None
+
+
+class RequestObserver:
+    """Subclass to observe requests; a before callback may reject before effects.
+
+    Exactly one completed or failed callback follows an admitted before callback.
+    A returned success=False output is still a completed request; inspect output
+    status separately. Observer exceptions propagate rather than enabling work.
+
+    Examples:
+        >>> observer = RequestObserver()
+        >>> with request_observation_scope(observer):
+        ...     check_execution_cancelled()
+    """
+
+    def before_request(self, event: RequestObservation) -> object:
+        """Admit a normalized request and return its correlation token."""
+        return None
+
+    def request_completed(self, event: RequestObservation, token: object) -> None:
+        """Observe the final public output, including captured failed outputs."""
+
+    def request_failed(self, event: RequestObservation, token: object, error: BaseException) -> None:
+        """Observe an escaping exception or cancellation."""
+
+
+@dataclass
+class _RequestScope:
+    observer: RequestObserver
+    control: ExecutionControl | None
+    active: bool = True
+
+
+_scope: ContextVar[_RequestScope | None] = ContextVar("proto_request_observer", default=None)
+_scope_lock = RLock()
+_managed_scope: _RequestScope | None = None
+_request: ContextVar[RequestObservation | None] = ContextVar("proto_observed_request", default=None)
+
+
+@contextmanager
+def request_observation_scope(observer: RequestObserver, control: ExecutionControl | None = None,
+                              *, require_scoped_calls: bool = False) -> Iterator[None]:
+    """Install one observer; optionally fence escaped calls in a managed process.
+
+    require_scoped_calls is opt-in for exclusive hosted execution. Unpropagated
+    child-thread requests then fail before effects. Ordinary unobserved execution
+    keeps its original behavior. Copied contexts expire when their owner exits.
+    """
+    global _managed_scope
+    with _scope_lock:
+        if _scope.get() is not None or _managed_scope is not None:
+            raise RuntimeError("A request observer is already installed in this context or managed process")
+        if control is not None:
+            control.check()
+        state = _RequestScope(observer, control)
+        if require_scoped_calls:
+            _managed_scope = state
+        handle = _scope.set(state)
+    try:
+        yield
+    finally:
+        with _scope_lock:
+            state.active = False
+            _scope.reset(handle)
+            if _managed_scope is state:
+                _managed_scope = None
+
+
+def check_execution_cancelled() -> None:
+    """Check context ownership and cancellation before an effect boundary."""
+    with _scope_lock:
+        state = _scope.get()
+        if _managed_scope is not None and state is not _managed_scope:
+            raise ExecutionCancelled("Registered request escaped the managed observation scope")
+        if state is not None:
+            if not state.active:
+                raise ExecutionCancelled("Registered request observation scope has expired")
+            if state.control is not None:
+                state.control.check()
+
+
+def set_request_cache_origin(origin: CacheOrigin) -> None:
+    """Record the actual registry branch, without changing output or cache data."""
+    event = _request.get()
+    if event is not None:
+        event.cache_origin = origin
+
+
+@contextmanager
+def observe_request(key: str, inputs: Any, config: Any) -> Iterator[RequestObservation | None]:
+    """Wrap exactly one registry invocation with identity-bound lifecycle events."""
+    check_execution_cancelled()
+    scope = _scope.get()
+    if scope is None:
+        yield None
+        return
+    observer = scope.observer
+    check_execution_cancelled()
+    parent = _request.get()
+    event = RequestObservation(uuid.uuid4().hex, key, inputs, config, parent.request_id if parent else None)
+    # Admission exceptions escape outside the registry's capture/retry machinery.
+    token = observer.before_request(event)
+    handle = _request.set(event)
+    try:
+        check_execution_cancelled()
+        yield event
+    except BaseException as error:
+        observer.request_failed(event, token, error)
+        raise
+    else:
+        observer.request_completed(event, token)
+    finally:
+        _request.reset(handle)
