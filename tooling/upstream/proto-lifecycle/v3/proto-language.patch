index 0000000..c2f0dfa
--- /dev/null
+++ b/proto_language/core/execution_observer.py
@@ -0,0 +1,202 @@
+"""Scoped public Generator.sample lifecycle observation.
+
+Sampling observations encompass the full native orchestration, including tied
+segment mirroring and stale metadata cleanup. They never replace generator or
+optimizer methods. Contexts do not implicitly propagate to threads/processes.
+
+Examples:
+    >>> observer = SamplingObserver()
+    >>> with sampling_observation_scope(observer):
+    ...     pass
+"""
+
+from __future__ import annotations
+
+import uuid
+from collections.abc import Iterator
+from contextlib import contextmanager
+from contextvars import ContextVar
+from dataclasses import dataclass
+from typing import Any
+from threading import RLock
+
+from proto_tools.utils.execution_observer import ExecutionCancelled, ExecutionControl, ObservationPublicationError, retain_observation_failure, check_execution_cancelled
+
+
+SCOPED_SAMPLING_API_VERSION = 1
+SCOPED_PROGRAM_GUARD_API_VERSION = 1
+HOSTED_PROCESS_FENCE_API_VERSION = 1
+
+
+@dataclass(frozen=True)
+class SamplingObservation:
+    """The exact generator and identity of one public sample invocation.
+
+    Examples:
+        >>> event = SamplingObservation("sample", object(), None)
+        >>> event.sample_id
+        'sample'
+    """
+
+    sample_id: str
+    generator: Any
+    parent_sample_id: str | None
+
+
+class SamplingObserver:
+    """Subclass to admit samples and capture their complete native outcome.
+
+    A before callback may reject before sampling. Only admitted calls receive
+    one completed/failed callback. Cancellation derives from BaseException and
+    therefore propagates across ordinary per-lane failure handling.
+
+    Examples:
+        >>> observer = SamplingObserver()
+        >>> with sampling_observation_scope(observer):
+        ...     pass
+    """
+
+    def before_sample(self, event: SamplingObservation) -> object:
+        """Admit a sample and return its opaque correlation token."""
+        return None
+
+    def sample_completed(self, event: SamplingObservation, token: object) -> None:
+        """Observe proposals after mirroring and metadata cleanup."""
+
+    def sample_failed(self, event: SamplingObservation, token: object, error: BaseException) -> None:
+        """Observe an escaping sampling failure or cancellation."""
+
+
+@dataclass
+class _SamplingScope:
+    observer: SamplingObserver
+    control: ExecutionControl | None
+    active: bool = True
+    managed: bool = False
+    publication_failed: bool = False
+    allow_program_execution: bool = True
+
+
+_scope: ContextVar[_SamplingScope | None] = ContextVar("proto_sampling_observer", default=None)
+_scope_lock = RLock()
+_managed_scope: _SamplingScope | None = None
+_unobserved_closed = False
+_sample: ContextVar[SamplingObservation | None] = ContextVar("proto_observed_sample", default=None)
+
+
+@contextmanager
+def sampling_observation_scope(observer: SamplingObserver, control: ExecutionControl | None = None,
+                               *, require_scoped_calls: bool = False, allow_program_execution: bool = True,
+                               keep_unobserved_closed: bool = False) -> Iterator[None]:
+    """Install one observer; optionally reject escaped hosted-process sampling.
+
+    Set allow_program_execution=False for construction-only inspection. Scope
+    admission itself remains usable; only an actual forbidden Program entry
+    cancels shared control. Copy the context explicitly for native concurrent work. Copies share the
+    observer/control and expire on scope exit. Unobserved use is unchanged.
+    keep_unobserved_closed irreversibly denies unobserved sampling/program
+    entries in this disposable hosted process, including gaps between scopes.
+    """
+    global _managed_scope, _unobserved_closed
+    if type(allow_program_execution) is not bool:
+        raise TypeError("allow_program_execution must be a boolean")
+    if type(keep_unobserved_closed) is not bool or (keep_unobserved_closed and not require_scoped_calls):
+        raise ValueError("A retained process fence requires explicit managed scopes")
+    with _scope_lock:
+        if _unobserved_closed and not require_scoped_calls:
+            raise ExecutionCancelled("Hosted process requires an explicit managed sampling scope")
+        if _scope.get() is not None or _managed_scope is not None:
+            raise RuntimeError("A sampling observer is already installed in this context or managed process")
+        if control is not None:
+            control.check()
+        state = _SamplingScope(observer, control, managed=require_scoped_calls, allow_program_execution=allow_program_execution)
+        if require_scoped_calls:
+            _managed_scope = state
+        if keep_unobserved_closed:
+            _unobserved_closed = True
+        handle = _scope.set(state)
+    try:
+        yield
+    finally:
+        with _scope_lock:
+            state.active = False
+            _scope.reset(handle)
+            if _managed_scope is state:
+                _managed_scope = None
+
+
+def check_sampling_cancelled() -> None:
+    """Check sampling scope authority and shared control before native work."""
+    with _scope_lock:
+        scope = _scope.get()
+        if _unobserved_closed and (scope is None or not scope.managed):
+            raise ExecutionCancelled("Hosted process denies unobserved sampling or program execution")
+        if _managed_scope is not None and scope is not _managed_scope:
+            raise ExecutionCancelled("Sampling escaped the managed observation scope")
+        if scope is not None:
+            if not scope.active:
+                raise ExecutionCancelled("Sampling observation scope has expired")
+            if scope.publication_failed:
+                raise ObservationPublicationError("Prior sample observation publication is unresolved")
+            if scope.control is not None:
+                scope.control.check()
+
+
+def check_program_execution_allowed() -> None:
+    """Reject native Program entries before state mutation or CPU/model work.
+
+    Ordinary unobserved execution and the default scope preserve native behavior.
+    Managed escaped/expired contexts are checked even if a CPU Program never
+    samples or requests a tool. Construction denial cancels only on a call.
+    """
+    check_sampling_cancelled()
+    check_execution_cancelled()
+    with _scope_lock:
+        scope = _scope.get()
+        if scope is not None and not scope.allow_program_execution:
+            if scope.control is not None:
+                scope.control.cancel()
+            raise ExecutionCancelled("Native program execution is forbidden during construction")
+
+
+@contextmanager
+def observe_sample(generator: Any) -> Iterator[None]:
+    """Observe the public sample body without modifying its scientific behavior."""
+    check_sampling_cancelled()
+    scope = _scope.get()
+    if scope is None:
+        yield
+        return
+    observer, control = scope.observer, scope.control
+    if control is not None:
+        control.check()
+    parent = _sample.get()
+    event = SamplingObservation(uuid.uuid4().hex, generator, parent.sample_id if parent else None)
+    token = observer.before_sample(event)
+    handle = _sample.set(event)
+    try:
+        if control is not None:
+            control.check()
+        yield
+    except BaseException as error:
+        try:
+            observer.sample_failed(event, token, error)
+        except BaseException as publication_error:
+            if scope.managed:
+                scope.publication_failed = True
+                if scope.control is not None:
+                    scope.control.cancel()
+            retain_observation_failure(error, publication_error, "Sampling")
+        raise
+    else:
+        try:
+            observer.sample_completed(event, token)
+        except BaseException as publication_error:
+            if scope.managed:
+                scope.publication_failed = True
+                if scope.control is not None:
+                    scope.control.cancel()
+                raise ObservationPublicationError("Completed sampling observation publication is unresolved") from publication_error
+            raise
+    finally:
+        _sample.reset(handle)
