{
  "name": "autofold",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend/engine",
    "frontend/ui",
    "frontend/workspace"
  ],
  "scripts": {
    "dev": "bun run backend/engine/src/web.ts --live --archives-dir .autofold --port 4450 --web-root frontend/workspace/dist",
    "agent": "bun run backend/engine/src/cli.ts",
    "trial": "python3 backend/engine/scripts/run_trial.py",
    "archive": "bun run backend/engine/src/web.ts",
    "frontend": "bun run --cwd frontend/workspace dev -- --host 127.0.0.1 --port 4447 --strictPort",
    "test": "npm run test --workspace @autofold/engine && npm run test --workspace @synsci/workspace",
    "typecheck": "npm run typecheck --workspaces",
    "start": "bun run backend/engine/src/web.ts --live --archives-dir .autofold --port 4450 --web-root frontend/workspace/dist",
    "build": "bun run --cwd frontend/workspace build"
  },
  "overrides": {
    "solid-js": "1.9.10",
    "babel-preset-solid": "1.9.10"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/node": "22.13.9",
    "typescript": "5.8.2"
  }
}
