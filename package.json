{
  "name": "autofold",
  "private": true,
  "type": "module",
  "workspaces": [
    "backend/cli",
    "frontend/workspace",
    "frontend/ui",
    "tooling/plugin",
    "tooling/script",
    "tooling/sdk/js",
    "tooling/util"
  ],
  "scripts": {
    "dev": "npm --workspace @synsci/workspace run dev",
    "dev:backend": "bun run --conditions=browser backend/cli/src/autofold-server.ts --port 4096 --cors http://127.0.0.1:3001",
    "research:cli": "bun run backend/cli/src/research/terminal.ts",
    "build": "npm --workspace @synsci/workspace run build",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@tsconfig/node22": "22.0.2",
    "@types/bun": "1.3.14",
    "@types/luxon": "3.7.1",
    "@types/node": "22.13.9",
    "@typescript/native-preview": "7.0.0-dev.20251207.1",
    "typescript": "5.8.2",
    "vite": "7.3.6",
    "vite-plugin-solid": "2.11.10"
  },
  "dependencies": {
    "solid-js": "1.9.10"
  }
}
